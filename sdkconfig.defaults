CONFIG_IDF_TARGET="esp32s31"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# BSP 显示 + LVGL 适配（esp_lvgl_adapter 0.6.2 + lvgl 9.5 由 BSP 依赖规则拉入）。
CONFIG_BSP_DISPLAY_ENABLE=y
CONFIG_BSP_DISPLAY_LVGL_ENABLE=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Persist ESP-IDF Core Dumps and the bounded ESP-Iris pre-crash log ring in
# the retained coredump partition after a panic.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=64
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_FACTORY_RECOVERY_BOOT_GPIO=7
CONFIG_FACTORY_RECOVERY_BOOT_DEBOUNCE_MS=50

# USB High-Speed is owned by ESP-Iris. Device installation and logs go through
# the repository's mosaico.py commands. Keep the console on UART and avoid the
# built-in USB Serial/JTAG controller.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_IRIS_TRANSPORT_USB=y
CONFIG_ESP_IRIS_TRANSPORT_TCP=y
CONFIG_ESP_IRIS_NVS_PARTITION_NAME="sysmeta"
CONFIG_ESP_IRIS_TRANSPORT_CLAIM_TIMEOUT_MS=2000
CONFIG_ESP_IRIS_TCP_PORT=19772
CONFIG_ESP_IRIS_TCP_PAIRING=y
CONFIG_ESP_IRIS_TCP_DEFER_UNTIL_NETIF=y
# ---------------------------------------------------------------------------
# 以下整块与已验证可上机的参考工程（qiaopi-quiz / english-podcast）逐行对齐。
# 最关键的一条：BSP 的 LVGL 显示路径注册 480x480 面板，帧缓冲只能来自 PSRAM，
# 缺了 CONFIG_SPIRAM 时 bsp_display_start() 分配失败直接返回 NULL —— 屏幕永远不亮。
# ---------------------------------------------------------------------------

# 16MB PSRAM（板载），XIP + 允许 .bss 放外部内存。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# CO5300 的 TE 脚：走 adapter 的 TE 抗撕裂路径。
CONFIG_BSP_CO5300_ENABLE_TE=y
# 与 BSP 官方 LVGL 示例一致：1ms tick，动画与触摸时序更细。
CONFIG_FREERTOS_HZ=1000

# ESP-Iris 服务与日志环放进 PSRAM，给 LVGL/音频留出内部 RAM。
CONFIG_ESP_IRIS_SERVICE_STACK_SIZE=4096
CONFIG_ESP_IRIS_SERVICE_PERSISTENT=y
CONFIG_ESP_IRIS_SERVICE_CONTEXT_PSRAM=y
CONFIG_ESP_IRIS_SERVICE_STATE_PSRAM=y
CONFIG_ESP_IRIS_RPC_RESPONSE_PSRAM=y
CONFIG_ESP_IRIS_WIRE_BUFFERS_PSRAM=y
CONFIG_ESP_IRIS_LOG_RING_BYTES=16384
CONFIG_ESP_IRIS_LOG_RING_STORAGE_PSRAM=y
# Mirror chunks are copied into ESP-Iris's wire frame before USB DMA.
CONFIG_ESP_IRIS_MEDIA_BUFFER_PSRAM=y
CONFIG_TINYUSB_CDC_RX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_TX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_EP_BUFSIZE=512

# app_main 里要做 BSP 初始化 + 建 UI，默认 3584 字节栈不够（会崩在启动阶段）。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480
# 与参考工程一致：音频/显示任务优先级高，空闲任务喂狗会被饿到，先不开任务看门狗。
CONFIG_ESP_TASK_WDT_INIT=n

# LVGL 直接用 clib 分配（静态池对三个中文字库 + 多页控件太紧）。
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
# LVGL 的 examples 与 demos 与本应用无关，关掉只影响编译时长与固件体积。
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n

CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.1.0"

CONFIG_ESP_IRIS_TASK_STACK_SIZE=3328
CONFIG_ESP_IRIS_USB_TASK_STACK_SIZE=2048

# ---------------------------------------------------------------------------
# 词典特有项（从 ESP32-C3 版 sdkconfig.defaults 继承，去掉与 C3/8MB 绑定的部分）
# ---------------------------------------------------------------------------

# 发音只解 MP3（esp_audio_codec 的解码器注册表按这张表裁剪，省 Flash）。
CONFIG_AUDIO_DECODER_MP3_SUPPORT=y
# CONFIG_AUDIO_DECODER_AAC_SUPPORT is not set
# CONFIG_AUDIO_DECODER_G711_SUPPORT is not set
# CONFIG_AUDIO_DECODER_AMRNB_SUPPORT is not set
# CONFIG_AUDIO_DECODER_AMRWB_SUPPORT is not set
# CONFIG_AUDIO_DECODER_FLAC_SUPPORT is not set
# CONFIG_AUDIO_DECODER_OPUS_SUPPORT is not set
# CONFIG_AUDIO_DECODER_VORBIS_SUPPORT is not set
# CONFIG_AUDIO_DECODER_ADPCM_SUPPORT is not set
# CONFIG_AUDIO_DECODER_ALAC_SUPPORT is not set
# CONFIG_AUDIO_DECODER_PCM_SUPPORT is not set
# CONFIG_AUDIO_DECODER_SBC_SUPPORT is not set
# CONFIG_AUDIO_DECODER_LC3_SUPPORT is not set
# CONFIG_AUDIO_DECODER_G722_SUPPORT is not set
# CONFIG_AUDIO_SIMPLE_DEC_WAV_SUPPORT is not set
# CONFIG_AUDIO_SIMPLE_DEC_M4A_SUPPORT is not set
# CONFIG_AUDIO_SIMPLE_DEC_TS_SUPPORT is not set
# CONFIG_AUDIO_SIMPLE_DEC_OGG_SUPPORT is not set

# 有道发音是明文 HTTP，但接口可能被重定向到 https（wd_audio.cc 挂着证书包跟随跳转）。
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# 配网门户（esp-wifi-connect 内置 httpd）的请求头/URI 上限。
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=256

# Wi-Fi 缓冲（C3 版沿用值；ESP32-S31 内存宽裕，保守不动）。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=5
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n

# CONFIG_BT_ENABLED is not set

# ---------------------------------------------------------------------------
# 发音缓存（/nand）：SPI NAND 走 BDL 分层块设备，LittleFS 挂 /nand。
# 缓存会把在线听过的词写到 NAND，卷可用约 121.7 MB，全卷归本应用使用。
# ---------------------------------------------------------------------------
CONFIG_NAND_FLASH_ENABLE_BDL=y
# BDL 报出的 block/read/prog 均为 2048；cache < 2048 时 LittleFS 直接
# ESP_ERR_INVALID_ARG（见 known-issues #16 坑 D）。
CONFIG_LITTLEFS_CACHE_SIZE=4096
# 命中时 touch、分片淘汰都依赖 mtime。
CONFIG_LITTLEFS_USE_MTIME=y

# ---------------------------------------------------------------------------
# 字库：48px / 32px 全字符集（3700+ 汉字）的位图超过 LVGL 默认 20 位
# bitmap_index 的 1 MB 上限（实测 3.69 MB / 1.66 MB），编译期会报
# -Werror=overflow。LVGL 为此提供 32 位索引的 large 模式，代价只是字形
# 描述符里 box_w/h/ofs 变宽（每字形 +8 B，合计约 60 KB）。
# ---------------------------------------------------------------------------
CONFIG_LV_FONT_FMT_TXT_LARGE=y
